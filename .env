APP_NAME=test

# 7.4, 8.0, 8.1, 8.2, 8.3
PHP_VERSION=8.4

# Make sure to download the respective install zip from https://download.simplemachines.org/index.php
# and place it in the "_docker" folder. The file should be named like "smf_2.1.7_install.zip" for version 2.1.7.
# An automatic download from the official source is currently not possible, because of the Cloudflare protection.
SMF_VERSION=2.1.7

MYSQL_ROOT_PASSWORD=root

DB_NAME=smf
DB_USER=user
DB_PASS=pass

#REDIS_USERNAME=myadmin
#REDIS_PASSWORD=password
#REDIS_DISABLE_DEFAULT_USER="true"
